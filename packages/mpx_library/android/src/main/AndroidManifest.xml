<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      No permissions on purpose (ADR 0011): a host that only links this
      plugin pays no permission. A host that reads the library declares
      READ_MEDIA_IMAGES, READ_MEDIA_VIDEO, READ_MEDIA_VISUAL_USER_SELECTED
      and READ_EXTERNAL_STORAGE (maxSdkVersion 32) itself; a host that saves
      to the gallery or Downloads on Android 9 and below declares
      WRITE_EXTERNAL_STORAGE (maxSdkVersion 28); see the README.
    -->
    <application>
        <!--
          Shares the system camera's output file with the camera app. A
          class of its own, so it never collides with a host's provider.
        -->
        <provider
            android:name="dev.mpx.library.MpxLibraryFileProvider"
            android:authorities="${applicationId}.mpx_library.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mpx_library_paths" />
        </provider>
    </application>
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>
</manifest>
